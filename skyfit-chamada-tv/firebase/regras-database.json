{
  "rules": {
    "unidades": {
      "$unidade": {
        "chamada": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.firebase.sign_in_provider == 'password'",
          ".validate": "newData.hasChildren(['id', 'modelo', 'cor', 'placa', 'ts', 'cancelada'])",
          "placa": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{3}[0-9][A-Z0-9][0-9]{2}$/)"
          },
          "modelo": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 30"
          },
          "cor": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "exibicoes": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
          }
        },
        "historico": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider == 'password'",
          "$item": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider == 'password'"
          },
          ".indexOn": [
            "ts"
          ]
        },
        "tvs": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider == 'password'",
          "$tvId": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['nome', 'lastSeen'])"
          }
        }
      }
    }
  }
}